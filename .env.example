# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=campusai

# JWT / Auth
JWT_SECRET=change_me_to_a_random_secret_in_production

# Cookies
COOKIE_SECURE=false
# Set to "true" and "none" respectively in deployed environments
COOKIE_SAMESITE=lax

# CORS
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000
CORS_ORIGIN_REGEX=

# OAuth (optional, for production)
OAUTH_SESSION_DATA_URL=

# AI / LLM (Groq direct HTTP access)
# Set one of these in backend/.env:
# LLM_API_KEY=your_groq_api_key
# GROQ_API_KEY=your_groq_api_key
# LLM_MODEL=groq/llama-3.3-70b-versatile
# LLM_QUIZ_MODEL=groq/llama-3.1-8b-instant

# Frontend (create frontend/.env.local from these)
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_OAUTH_URL=
REACT_APP_ENABLE_DEV_LOGIN=true

