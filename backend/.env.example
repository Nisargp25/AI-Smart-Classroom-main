# Copy to backend/.env and adjust values

# Mongo
MONGO_URL=mongodb://localhost:27017
DB_NAME=campusai

# JWT
JWT_SECRET=change_me

# Cookie behavior
# For local dev between localhost:4000 and localhost:8000, keep secure=false and samesite=lax.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS (comma-separated origins)
CORS_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:3000,http://localhost:3000

# OAuth provider (only needed for external OAuth)
OAUTH_SESSION_DATA_URL=

